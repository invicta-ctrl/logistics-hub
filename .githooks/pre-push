#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac
  case "$remote_sha" in
    *[!0]*) base="$remote_sha" ;;
    *) base=$(git merge-base "$local_sha" "refs/remotes/$1/main" 2>/dev/null || git hash-object -t tree -w --stdin </dev/null) ;;
  esac
  node scripts/check-governance.mjs --ref "$local_sha"
  node scripts/check-docs.mjs --range "$base" "$local_sha"
done
