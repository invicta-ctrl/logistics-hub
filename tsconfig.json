{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/main.ts", "src/catalog-policy.ts", "src/session.ts", "tests", "vite.config.ts", "playwright.config.ts"],
  "exclude": ["tests/worker.test.ts"]
}
