{
  "permissions": {
    "allow": [
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)"
    ]
  },
  "agent": "kawing-orchestrator",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/delegation-guard.mjs"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/delegation-guard.mjs"
            ]
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "hallmark@hallmark": true,
    "impeccable@impeccable": true,
    "ponytail@ponytail": true,
    "mattpocock-skills@claude-plugins-official": true,
    "cloudflare@cloudflare": true,
    "claude-security@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "web-quality-skills@addy-web-quality-skills": true
  },
  "extraKnownMarketplaces": {
    "hallmark": {
      "source": {
        "source": "github",
        "repo": "nutlope/hallmark"
      }
    },
    "impeccable": {
      "source": {
        "source": "github",
        "repo": "pbakaus/impeccable"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "addy-web-quality-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/web-quality-skills"
      }
    }
  },
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1"
  }
}
