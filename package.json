{
  "name": "logistics-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:live": "node scripts/run-live-dev.mjs",
    "preview:sync-cloud": "node scripts/sync-cloud-preview.mjs",
    "dev:worker": "npm run build && wrangler dev --local",
    "admin": "node scripts/admin.mjs",
    "agent:status": "node scripts/agent-lock.mjs status",
    "agent:claim": "node scripts/agent-lock.mjs claim",
    "agent:yield": "node scripts/agent-lock.mjs yield",
    "build": "npm run typecheck && vite build",
    "typecheck": "wrangler types && tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.sw.json",
    "generate:types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "test:browser:worker": "node scripts/run-worker-browser-tests.mjs",
    "verify:migration": "node scripts/verify-migration-data.mjs",
    "verify:catalog": "node scripts/report-public-catalog.mjs",
    "verify:privacy": "node scripts/privacy-scan.mjs",
    "verify:restore": "node scripts/verify-restore.mjs",
    "evidence": "node scripts/visual-evidence.mjs",
    "ops:release": "node scripts/ops/production-release.mjs",
    "evaluate:suggestions": "node scripts/evaluate-suggestions.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  }
}
