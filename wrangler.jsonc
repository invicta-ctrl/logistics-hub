{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Isolated Logistics Hub resources. Never point this at the old
  // hau-usc-logistics-production / hau-usc-logistics-staging resources.
  "name": "logistics-hub",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-28",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logistics-hub",
      "database_id": "3ffd8edf-a176-4f63-8b7c-5215d11c98d8",
      "migrations_dir": "migrations"
    }
  ],
  // Loan photos: staff-only, streamed through the Worker, never public.
  "r2_buckets": [
    { "binding": "EVIDENCE", "bucket_name": "logistics-hub-evidence" }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  }
}
